<launch>
  <arg name="localization" default="openvins" />
  <arg name="bridge_launch"
       default="$(eval {'openvins': 'openvins.launch', 'schurvins': 'schurvins.launch'}[arg('localization')])" />
  <arg name="input_topic"
       default="$(eval {'openvins': '/ov_msckf/odomimu', 'schurvins': '/svo/pose_imu'}[arg('localization')])" />
  <arg name="bridge_config_name"
       default="$(eval {'openvins': 'openvins.yaml', 'schurvins': 'schurvins.yaml'}[arg('localization')])" />
  <arg name="bridge_config" default="$(find vins_mavros_bridge)/config/$(arg bridge_config_name)" />
  <arg name="odom_topic" default="/localization/odometry" />
  <arg name="drone_id" default="0" />

  <include file="$(find vins_mavros_bridge)/launch/$(arg bridge_launch)">
    <arg name="input_topic" value="$(arg input_topic)" />
    <arg name="config" value="$(arg bridge_config)" />
  </include>

  <include file="$(find ego_planner)/launch/single_run_in_exp.launch">
    <arg name="drone_id" value="$(arg drone_id)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
  </include>

  <include file="$(find px4ctrl)/launch/run_ctrl.launch">
    <arg name="odom_topic" value="$(arg odom_topic)" />
  </include>
</launch>
