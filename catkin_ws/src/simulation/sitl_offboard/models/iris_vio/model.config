<?xml version="1.0"?>
<model>
  <name>Iris VIO</name>
  <version>1.0</version>
  <sdf version="1.6">iris_vio.sdf</sdf>

  <author>
    <name>rmUAV</name>
    <email>maintainer@example.com</email>
  </author>

  <description>
    3DR Iris quadrotor (model://iris) with a forward-facing VIO sensor suite:
    a 848x480 RGB camera, a registered 848x480 depth camera, a 200 Hz ROS IMU,
    and a ground-truth camera pose publisher, all co-located on one link.
  </description>
</model>
