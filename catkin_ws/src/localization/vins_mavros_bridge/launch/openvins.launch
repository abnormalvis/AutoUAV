<launch>
  <!-- OpenVINS adapter. Start OpenVINS itself separately; this only starts the
       bridge, so VIO and bridge lifetimes stay independent. -->
  <arg name="input_topic" default="/ov_msckf/odomimu" />
  <arg name="config" default="$(find vins_mavros_bridge)/config/openvins.yaml" />
  <arg name="publish_vision_pose" default="true" />
  <arg name="publish_mavros_odometry" default="false" />

  <node pkg="vins_mavros_bridge" type="vins_mavros_bridge_node" name="vins_mavros_bridge"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="publish_vision_pose" value="$(arg publish_vision_pose)" />
    <param name="publish_mavros_odometry" value="$(arg publish_mavros_odometry)" />
  </node>
</launch>
