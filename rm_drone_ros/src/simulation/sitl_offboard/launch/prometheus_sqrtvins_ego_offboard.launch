<launch>
  <arg name="uav_id" default="1" />
  <arg name="world" default="$(find prometheus_gazebo)/gazebo_worlds/planning_worlds/planning_easy.world" />
  <arg name="uav_init_x" default="0.0" />
  <arg name="uav_init_y" default="0.0" />
  <arg name="uav_init_yaw" default="0.0" />
  <arg name="px4_src" default="/home/idris-24-04/px4_ws/PX4-Autopilot" />
  <arg name="px4_build" default="/home/idris-24-04/px4_ws/PX4-Autopilot/build/px4_sitl_default" />
  <arg name="start_gazebo" default="true" />
  <arg name="start_px4" default="true" />
  <arg name="start_mavros" default="true" />
  <arg name="start_vio" default="true" />
  <arg name="start_ego" default="false" />
  <arg name="enable_flight" default="false" />
  <arg name="p450_airframe_verified" default="false" />
  <arg name="start_rviz" default="false" />
  <arg name="camera_topic" default="/uav$(arg uav_id)/camera/color/image_raw" />
  <arg name="imu_topic" default="/uav$(arg uav_id)/mavros/imu/data_raw" />
  <arg name="sqrtvins_config" default="$(find ov_srvins)/../config/gazebo_p450/estimator_config.yaml" />
  <arg name="mavros_fcu_url" default="udp://:14540@127.0.0.1:14580" />
  <arg name="takeoff_height" default="0.5" />
  <arg name="takeoff_vertical_speed" default="0.2" />
  <arg name="max_velocity" default="0.5" />
  <arg name="max_acc" default="0.6" />
  <arg name="sensor_timeout" default="2.0" />
  <arg name="vio_stable_duration" default="2.0" />
  <arg name="vio_init_timeout" default="45.0" />
  <arg name="bootstrap_timeout" default="20.0" />

  <env name="PX4_HOME" value="$(arg px4_src)" />
  <env name="PX4_BUILD_DIR" value="$(arg px4_build)" />
  <env name="GAZEBO_MODEL_PATH" value="$(find prometheus_gazebo)/gazebo_models:$(arg px4_src)/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models:$(optenv GAZEBO_MODEL_PATH)" />
  <env name="GAZEBO_PLUGIN_PATH" value="$(arg px4_build)/build_gazebo-classic:$(optenv GAZEBO_PLUGIN_PATH)" />
  <env name="LD_LIBRARY_PATH" value="$(arg px4_build)/build_gazebo-classic:$(optenv LD_LIBRARY_PATH)" />

  <group if="$(arg start_gazebo)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world)" />
      <arg name="paused" value="false" />
      <arg name="use_sim_time" value="true" />
      <arg name="gui" value="true" />
      <arg name="headless" value="false" />
      <arg name="debug" value="false" />
      <arg name="verbose" value="false" />
    </include>
  </group>

  <arg name="model_id" value="$(eval int(arg('uav_id')) - 1)" />
  <arg name="mavlink_udp_port" value="$(eval 14560 + int(arg('uav_id')) - 1)" />
  <arg name="mavlink_tcp_port" value="$(eval 4560 + int(arg('uav_id')) - 1)" />
  <arg name="sdf_command" default="$(find prometheus_gazebo)/scripts/jinja_gen.py --stdout --mavlink_id=$(arg uav_id) --mavlink_udp_port=$(arg mavlink_udp_port) --mavlink_tcp_port=$(arg mavlink_tcp_port) --send_odometry=0 $(find prometheus_gazebo)/gazebo_models/uav_models/p450_D435i/p450_D435i.sdf.jinja $(find prometheus_gazebo)" />
  <param name="sdf_p450_D435i_$(arg model_id)" command="$(arg sdf_command)" />
  <node if="$(arg start_gazebo)" name="spawn_p450_d435i" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -param sdf_p450_D435i_$(arg model_id) -model p450_D435i_$(arg uav_id) -x $(arg uav_init_x) -y $(arg uav_init_y) -z 0.15 -Y $(arg uav_init_yaw)" />

  <node if="$(arg start_px4)" pkg="sitl_offboard" type="run_prometheus_px4_sitl.sh" name="px4_sitl" output="screen">
    <env name="PX4_SYS_AUTOSTART" value="10015" />
    <env name="PX4_SIM_MODEL" value="gazebo-classic_p450_D435i" />
    <env name="PX4_SIM_WORLD" value="planning_easy" />
  </node>

  <group ns="uav$(arg uav_id)" if="$(arg start_mavros)">
    <node pkg="mavros" type="mavros_node" name="mavros" output="screen">
      <param name="fcu_url" value="$(arg mavros_fcu_url)" />
      <param name="gcs_url" value="" />
      <param name="target_system_id" value="$(arg uav_id)" />
      <param name="target_component_id" value="1" />
      <rosparam command="load" file="$(find prometheus_gazebo)/config/mavros_config/px4_config_outdoor.yaml" />
      <rosparam command="load" file="$(find prometheus_gazebo)/config/mavros_config/px4_pluginlists_outdoor.yaml" />
    </node>
  </group>

  <group if="$(arg start_vio)">
    <include file="$(find ov_srvins)/launch/subscribe.launch">
      <arg name="config_path" value="$(arg sqrtvins_config)" />
      <arg name="max_cameras" value="1" />
      <arg name="use_stereo" value="false" />
      <arg name="topic_camera0" value="$(arg camera_topic)" />
      <arg name="topic_imu" value="$(arg imu_topic)" />
      <arg name="dobag" value="false" />
      <arg name="dosave" value="false" />
      <arg name="dolivetraj" value="false" />
    </include>

    <node pkg="offboard" type="vins_odometry_adapter" name="vins_odometry_adapter" output="screen">
      <param name="input_topic" value="/ov_srvins/odomimu" />
      <param name="odometry_topic" value="/uav$(arg uav_id)/vins/odom" />
      <param name="vision_pose_topic" value="/uav$(arg uav_id)/mavros/vision_pose/pose" />
      <param name="frame_id" value="world" />
      <param name="child_frame_id" value="uav$(arg uav_id)/base_link" />
      <param name="initial_x" value="$(arg uav_init_x)" />
      <param name="initial_y" value="$(arg uav_init_y)" />
      <param name="initial_z" value="0.15" />
      <param name="initial_yaw" value="$(arg uav_init_yaw)" />
    </node>
  </group>

  <group if="$(arg start_ego)">
    <include file="$(find ego_planner)/launch/advanced_param_exp.xml">
      <arg name="drone_id" value="0" />
      <arg name="map_size_x_" value="8.0" />
      <arg name="map_size_y_" value="8.0" />
      <arg name="map_size_z_" value="3.0" />
      <arg name="odometry_topic" value="/uav$(arg uav_id)/vins/odom" />
      <arg name="camera_pose_topic" value="/uav$(arg uav_id)/mavros/vision_pose/pose" />
      <arg name="depth_topic" value="/uav$(arg uav_id)/camera/depth/image_raw" />
      <arg name="cloud_topic" value="unused_cloud" />
      <arg name="cx" value="320.0" />
      <arg name="cy" value="240.0" />
      <arg name="fx" value="466.2" />
      <arg name="fy" value="466.2" />
      <arg name="max_vel" value="$(arg max_velocity)" />
      <arg name="max_acc" value="$(arg max_acc)" />
      <arg name="planning_horizon" value="3.0" />
      <arg name="point_num" value="2" />
      <arg name="point0_x" value="1.0" />
      <arg name="point0_y" value="0.0" />
      <arg name="point0_z" value="0.8" />
      <arg name="point1_x" value="0.0" />
      <arg name="point1_y" value="0.0" />
      <arg name="point1_z" value="0.8" />
      <arg name="point2_x" value="1.0" />
      <arg name="point2_y" value="0.0" />
      <arg name="point2_z" value="0.8" />
      <arg name="point3_x" value="0.0" />
      <arg name="point3_y" value="0.0" />
      <arg name="point3_z" value="0.8" />
      <arg name="point4_x" value="1.0" />
      <arg name="point4_y" value="0.0" />
      <arg name="point4_z" value="0.8" />
      <arg name="flight_type" value="2" />
      <arg name="realworld_experiment" value="true" />
      <arg name="use_distinctive_trajs" value="false" />
      <arg name="obj_num_set" value="0" />
    </include>

    <node pkg="ego_planner" name="drone_0_traj_server" type="traj_server" output="screen">
      <remap from="position_cmd" to="/position_cmd" />
      <remap from="~planning/bspline" to="/drone_0_planning/bspline" />
      <param name="traj_server/time_forward" value="1.0" />
    </node>
  </group>

  <group if="$(eval arg('enable_flight') and arg('start_ego') and arg('p450_airframe_verified'))">
    <node pkg="offboard" type="offboard_planner_tracker_node" name="offboard_planner_tracker" output="screen">
      <remap from="/mavros/state" to="/uav$(arg uav_id)/mavros/state" />
      <remap from="/mavros/altitude" to="/uav$(arg uav_id)/mavros/altitude" />
      <remap from="/mavros/estimator_status" to="/uav$(arg uav_id)/mavros/estimator_status" />
      <remap from="/mavros/set_mode" to="/uav$(arg uav_id)/mavros/set_mode" />
      <remap from="/mavros/cmd/arming" to="/uav$(arg uav_id)/mavros/cmd/arming" />
      <remap from="/mavros/setpoint_raw/local" to="/uav$(arg uav_id)/mavros/setpoint_raw/local" />
      <remap from="/ov_msckf/odomimu" to="/uav$(arg uav_id)/vins/odom" />
      <remap from="/position_cmd" to="/position_cmd" />
      <param name="takeoff_height" value="$(arg takeoff_height)" />
      <param name="takeoff_vertical_speed" value="$(arg takeoff_vertical_speed)" />
      <param name="max_velocity" value="$(arg max_velocity)" />
      <param name="sensor_timeout" value="$(arg sensor_timeout)" />
      <param name="vio_stable_duration" value="$(arg vio_stable_duration)" />
      <param name="vio_init_timeout" value="$(arg vio_init_timeout)" />
      <param name="bootstrap_timeout" value="$(arg bootstrap_timeout)" />
    </node>
  </group>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="prometheus_vio_rviz" output="screen" />
</launch>
