<launch>
  <arg name="fcu_url" default="udp://:14550@127.0.0.1:18570" />
  <arg name="gcs_url" default="" />
  <arg name="start_mavros" default="true" />
  <arg name="start_vins" default="true" />
  <arg name="start_ego" default="true" />
  <arg name="start_px4ctrl" default="true" />
  <arg name="vins_config" default="$(find sitl_offboard)/config/sitl_iris/vins_fusion_stereo.yaml" />
  <arg name="odom_topic" default="/localization/odometry" />
  <arg name="enable_rc_free_takeoff" default="true" />

  <group if="$(arg start_mavros)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="$(arg fcu_url)" />
      <arg name="gcs_url" value="$(arg gcs_url)" />
    </include>
  </group>

  <group if="$(arg start_vins)">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen"
          args="$(arg vins_config)" />
  </group>

  <include file="$(find vins_mavros_bridge)/launch/vins_fusion.launch" />

  <group if="$(arg start_ego)">
    <include file="$(find ego_planner)/launch/single_run_in_exp.launch">
      <arg name="odom_topic" value="$(arg odom_topic)" />
    </include>
  </group>

  <group if="$(arg start_px4ctrl)">
    <node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl" output="screen">
      <remap from="~odom" to="$(arg odom_topic)" />
      <remap from="~cmd" to="/position_cmd" />
      <rosparam command="load" file="$(find px4ctrl)/config/ctrl_param_fpv.yaml" />
      <param name="auto_takeoff_land/enable_auto_arm" value="$(arg enable_rc_free_takeoff)" />
      <param name="auto_takeoff_land/no_RC" value="$(arg enable_rc_free_takeoff)" />
    </node>
  </group>
</launch>
