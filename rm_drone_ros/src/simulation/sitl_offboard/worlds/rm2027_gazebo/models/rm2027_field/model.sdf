<?xml version="1.0" encoding="UTF-8"?>
<!--
  独立模型版本：把整个赛场作为一个可复用 model 加载。
  道具相对坐标与 rm2027_arena.world 完全一致，仅把世界坐标平移到模型局部坐标。
  加载示例：
    <include>
      <uri>model://rm2027_field</uri>
      <name>arena</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
-->
