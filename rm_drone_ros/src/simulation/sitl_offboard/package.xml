<?xml version="1.0"?>
<package format="2">
  <name>sitl_offboard</name>
  <version>0.1.0</version>
  <description>ROS 1 integration entry points for PX4 SITL, VIO, EGO-Planner, and px4ctrl.</description>

  <maintainer email="maintainer@example.com">rmUAV maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ego_planner</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ov_msckf</exec_depend>
  <exec_depend>px4ctrl</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vins_mavros_bridge</exec_depend>

  <export/>
</package>