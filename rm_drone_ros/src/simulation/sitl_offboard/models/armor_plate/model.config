<?xml version="1.0"?>
<model>
  <name>Armor Plate</name>
  <version>1.0</version>
  <sdf version="1.6">armor_plate.sdf</sdf>

  <author>
    <name>rmUAV</name>
    <email>maintainer@example.com</email>
  </author>

  <description>
    Static RoboMaster armor plate for perception SITL. Emissive light bars so
    the threshold-and-contour detector sees them under any scene lighting.
    Geometry matches armor_perception/config/uav_sitl.yaml:
    light bar 56 mm tall, 135 mm between light bar centres.
  </description>
</model>
