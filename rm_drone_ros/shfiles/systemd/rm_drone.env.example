# Copy to /etc/rm_drone/rm_drone.env and edit.
FCU_URL=/dev/ttyACM0:921600
# LOCALIZATION: schurvins | openvins
LOCALIZATION=schurvins
ROS_DISTRO_NAME=noetic
#RM_DRONE_WS=/home/orangepi/rmUAV/rm_drone_ros
#SVO_WS=/home/orangepi/rmUAV/svo_ws

# Camera (RealSense is built outside this workspace)
#CAMERA_SETUP=/home/orangepi/realsense_ws/devel/setup.bash
CAM0_TOPIC=/camera/infra1/image_rect_raw
CAM1_TOPIC=/camera/infra2/image_rect_raw
# D430 has no IMU: use the flight controller IMU
IMU_TOPIC=/mavros/imu/data_raw
IMU_RATE_HZ=200

# SchurVINS live launch (D430 + PX4 IMU) (required for LOCALIZATION=schurvins)
#SVO_LAUNCH=/path/to/live_d430_px4imu.launch   # default: config/d430_schurvins/
# OpenVINS
#OV_CONFIG=/path/to/estimator_config.yaml
